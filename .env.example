# Copy to .env.local and fill in. Never commit real values.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — secrets must not use it.

# --- Admin panel auth (server-side only) ---
# Generate the hash and secret with: npm run admin:hash -- '<your password>'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Content API (aivtechx agent service) ---
PORTFOLIO_API_URL=https://ai.vtechxhub.com/api/v1
PORTFOLIO_API_KEY=

# --- Blog extractor ---
OPENAI_API_KEY=

# --- Site ---
NEXT_PUBLIC_WEB_SITE=https://officialdeepak.in

# Google AdSense — ads render only when ENABLED is "true" and PUB_ID is set.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-9938405758384510
# Ad-unit IDs from AdSense → Ads → By ad unit. A slot left empty renders nothing.
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
